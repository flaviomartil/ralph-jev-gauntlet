  "cards": [
    {
      "dot": "emerald",
      "title": "Evidence, not claims",
      "items": [
        "Commits, status and changed files come from git",
        "Closed tasks and recent events come from .ralph",
        "The agent's own summary is not trusted"
      ]
    },
    {
      "dot": "amber",
      "title": "Checks first",
      "items": [
        "RALPH_JEV_VERIFY_CMD runs before Jev",
        "A failing check rejects immediately",
        "Its output tail goes into the reason"
      ]
    },
    {
      "dot": "rose",
      "title": "Safe by default",
      "items": [
        "Secrets are masked before any request",
        "Timeouts kill the whole process group",
        "Jev errors fail open unless fail_closed is set"
      ]
    }
